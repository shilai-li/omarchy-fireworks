import QtQuick
import "../plugin" as Plugin

Item {
    // Force an early binding read, as Fireworks.qml does before pool delegates
    // have been constructed. It must become true when the first slot is used.
    property bool flying: pool.activeCount > 0
    Plugin.LaunchPool { id: pool; sound: false }
    property int phase: 0
    property real firstTime: 0
    property real visibleOrigin: 0
    Plugin.LaunchPool { id: randomPool; sound: false }
    // A catalog size fixed here rather than read from the director: this test
    // is about the schedule, and should not change when a shell is added.
    Plugin.LaunchPool { id: displayPool; sound: false; shellCount: 10 }
    property int idleTicks: 0
    Connections {
        target: {
            var revision = randomPool.slotRevision
            return randomPool.slot(0)
        }
        function onReadyChanged() {
            if (target.ready) visibleOrigin = target.controller.originX
        }
    }
    function check(value, message) {
        if (!value) { console.error(message); Qt.exit(1) }
    }
    Component.onCompleted: {
        pool.launch(0, false, -0.5, false)
        check(pool.activeCount === 1, "launch must immediately reserve a slot")
        check(flying, "early-bound overlay visibility must follow slot creation")
        randomPool.launch(0, true, 0, true)
        check(!randomPool.slot(0).ready,
              "a pending random launch must not render a provisional rocket")

        // A schedule that peaked above the slot ceiling would evict its own
        // shells in mid-air, so the table and the capacity are checked against
        // each other rather than trusted to stay in step.
        for (var d = 0; d < displayPool.displays.length; ++d) {
            var plan = displayPool.displays[d]
            check(plan.lifts.length > 0, "every display must launch something: " + plan.name)
            check(displayPool.peakConcurrency(plan) <= displayPool.capacity,
                  "display must not outgrow the slot capacity: " + plan.name)
        }
        var firstPick = displayPool.mixedShell(0)
        check(firstPick >= 0 && firstPick < 10, "a mixed pick must name a real shell")
        check(displayPool.mixedShell(1) !== firstPick,
              "a mixed display must not fire the same shell every step")
        displayPool.launchDisplay(0, 3, true, 0, false)
        check(displayPool.activeCount === 1 && !displayPool.scheduled,
              "one shell must fire once and queue nothing")
        check(displayPool.slot(0).controller.shellType === 3,
              "one shell must use the chosen shell")
    }
    Timer {
        interval: 200; running: true; repeat: true
        onTriggered: {
            if (phase === 0) {
                check(randomPool.slot(0).ready, "random launch must become visible when running")
                check(randomPool.slot(0).controller.originX === visibleOrigin,
                      "the position must be resolved before the first visible frame")
                randomPool.stop()
                check(pool.slot(0).controller.running, "first launch must start")
                firstTime = pool.slot(0).controller.time
                pool.launch(7, true, 0.5, false)
                check(pool.activeCount === 2, "second launch must overlap the first")
            } else if (phase === 1) {
                check(pool.slot(0).controller.time > firstTime + 0.1,
                      "second launch must not reset or pause the first clock")
                check(pool.slot(0).controller.shellType === 0 &&
                      pool.slot(1).controller.shellType === 7,
                      "overlapping launches must retain independent shell types")
                check(pool.slot(0).controller.originX < 0 && pool.slot(1).controller.originX > 0,
                      "overlapping launches must retain their positions")
                check(!pool.slot(0).quiet && pool.slot(1).quiet,
                      "per-launch mute must not affect other launches")
                for (var i = 0; i < 8; ++i) pool.launch(i, true, 0, false)
                check(pool.activeCount === pool.capacity, "rapid launches must stay bounded")
                for (var j = 0; j < pool.capacity; ++j)
                    check(pool.slot(j).serial > 6, "full pool must replace the oldest launch")
                pool.stop()
            } else if (phase === 2) {
                check(pool.activeCount === 0, "close must clear all pending launches")
                for (var k = 0; k < pool.capacity; ++k)
                    check(!pool.slot(k).controller.running, "cancelled timer must not restart audio/clock")
                pool.launch(8, true, 0, false)
                pool.launch(9, true, 0, false)
            } else if (phase === 3) {
                for (var n = 0; n < 2; ++n) {
                    var clock = pool.slot(n).controller
                    clock.seek(clock.duration - 0.03)
                    clock.resume()
                }
            } else if (phase === 4) {
                check(pool.activeCount === 0, "last shell finishing must release the overlay")
                // Drive the full show's queue by hand rather than waiting out
                // its schedule: the test budget is ten seconds and the display
                // takes fifteen to lift its last shell.
                displayPool.stop()
                displayPool.launchDisplay(2, 5, true, 0, false)
                check(displayPool.scheduled, "a full show must queue the shells behind the first")
                var guard = 0
                while (displayPool.scheduled && ++guard < 40) displayPool.fireStep()
                check(!displayPool.scheduled, "a display must finish its queue")
                check(guard === displayPool.displays[2].lifts.length - 1,
                      "a display must fire each of its lifts once")
                // The newest slots ran the finale, and a finale is the shell
                // that was actually chosen even when the rest was mixed.
                var newest = []
                for (var i = 0; i < displayPool.capacity; ++i) newest.push(displayPool.slot(i))
                newest.sort(function(a, b) { return b.serial - a.serial })
                for (var f = 0; f < displayPool.displays[2].finale; ++f)
                    check(newest[f].controller.shellType === 5,
                          "a mixed display must end on the chosen shell")
                displayPool.stop()
                check(!displayPool.scheduled && displayPool.activeCount === 0,
                      "stopping must cancel a queued display and its shells")
                displayPool.launchDisplay(1, 2, true, 0, false)
                check(displayPool.scheduled && displayPool.activeCount === 1,
                      "a volley must fire once and queue the rest")
                displayPool.stop()
            } else if (phase === 5) {
                // Past the volley's own 1.3 s step, so a cancelled schedule
                // that was still armed would have fired by now.
                if (++idleTicks < 9) return
                check(!displayPool.scheduled && displayPool.activeCount === 0,
                      "a cancelled display must stay cancelled")
            } else {
                console.log("PASS: overlapping clocks, styles, positions, mute, capacity, cancellation, cleanup, display schedules")
                Qt.quit()
            }
            ++phase
        }
    }
}
